# Get a NEW token from @BotFather; NEVER send it to anyone.
BOT_TOKEN=PASTE_YOUR_NEW_TOKEN_HERE
# Local web preview: http://127.0.0.1:8090/?preview=1
ENABLE_WEB=1
WEB_HOST=127.0.0.1
WEB_PORT=8090
# Public HTTPS address (reverse proxy to WEB_PORT) for Telegram Mini App:
WEBAPP_URL=

# Optional trusted automatic updates (ONLY when starting with python launcher.py)
# Keep off until you configure your own release repository.
AUTO_UPDATE=0
UPDATE_MANIFEST_URL=
UPDATE_CHANNEL=beta
UPDATE_CHECK_INTERVAL=3600
# Comma-separated EXACT domain names allowed for manifest/archive URLs and redirects.
UPDATE_ALLOWED_HOSTS=raw.githubusercontent.com,github.com,release-assets.githubusercontent.com,objects.githubusercontent.com

# Release announcements: disabled until you want opt-in subscribers informed.
# Users must send /start and then /news on in private chat.
ANNOUNCE_UPDATES=0
